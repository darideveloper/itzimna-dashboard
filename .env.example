# Copy this file to .env.dev and fill in real values. Do NOT commit .env.dev.
# Example / template only — all values below are placeholders.

# Django
SECRET_KEY=change-me-generate-a-new-django-secret-key
DEBUG=True
HOST=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
TEST_HEADLESS=True

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Database
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAILS_LEADS_NOTIFICATIONS=notify1@example.com,notify2@example.com

# Storage
STORAGE_AWS=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_PROJECT_FOLDER=your-project-folder
AWS_S3_REGION_NAME=your-s3-region
AWS_S3_ENDPOINT_URL=https://your-region.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=your-bucket.your-region.cdn.digitaloceanspaces.com
